# Keys for arkennemasis nodes. Copy the lines you need into the .env file of your ComfyUI
# install - in the portable build that is the folder holding run_nvidia_gpu.bat.

# fal.ai — https://fal.ai/dashboard/keys
# The fal nodes read FAL_KEY ONLY from that .env (or a .env inside the ComfyUI folder).
# There is no key field on the nodes, on purpose: a key typed into a node is saved into
# every workflow file and image you share.
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ScreenshotOne (the ScreenshotOne node) — https://screenshotone.com
# SCREENSHOTONE_ACCESS_KEY=...
# SCREENSHOTONE_SECRET_KEY=...
